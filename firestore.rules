rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper global: exige usuário autenticado E com e-mail verificado no token JWT
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // 1. REGRA PÚBLICA: Qualquer um pode ler a versão mínima (Essencial para o ForceUpdate funcionar antes do login)
    match /system/config {
      allow read: if true;
      allow write: if false; // Só você altera via Console do Firebase
    }

    // ============================================================================
    // REGRA GLOBAL: Usuário autenticado com e-mail verificado
    // ============================================================================

    // --- DADOS DO USUÁRIO (Projetos e sub-coleções) ---
    match /artifacts/ftth-production/users/{userId} {
      // O dono tem acesso total ao seu próprio documento
      allow read, write: if isVerifiedUser() && request.auth.uid == userId;

      // Documento de settings do usuário
      match /settings/{settingId} {
        allow read, write: if isVerifiedUser() && request.auth.uid == userId;
        // Convidados FULL_ACCESS podem ler settings
        allow read: if isVerifiedUser();
      }

      // --- PROJETOS ---
      match /projects/{projectId} {
        // Dono: acesso total
        allow read, write: if isVerifiedUser() && request.auth.uid == userId;
        // Convidados: podem ler (a filtragem é feita na camada de aplicação/Cloud Function)
        allow read: if isVerifiedUser();

        // --- ITENS DO PROJETO ---
        match /items/{itemId} {
          // Dono: acesso total
          allow read, write: if isVerifiedUser() && request.auth.uid == userId;
          // Convidados: podem ler (data scrubbing feito no frontend/Cloud Function)
          allow read: if isVerifiedUser();
          // Escrita por convidados: reforçada pela Cloud Function validateWritePermission
          allow write: if isVerifiedUser();
        }

        // --- CONEXÕES DO PROJETO ---
        match /connections/{connId} {
          allow read, write: if isVerifiedUser() && request.auth.uid == userId;
          allow read: if isVerifiedUser();
          allow write: if isVerifiedUser();
        }

        // --- SETTINGS DO PROJETO ---
        match /settings/{settingId} {
          allow read, write: if isVerifiedUser() && request.auth.uid == userId;
          allow read: if isVerifiedUser();
          allow write: if isVerifiedUser();
        }
      }
    }

    // --- PERFIS DE USUÁRIO (para audit trail / lookup de nomes) ---
    match /artifacts/ftth-production/userProfiles/{userId} {
      // Qualquer usuário verificado pode ler perfis (necessário para audit trail)
      allow read: if isVerifiedUser();
      // Apenas o próprio usuário verificado pode escrever/atualizar seu perfil
      allow write: if isVerifiedUser() && request.auth.uid == userId;
    }

    // --- CONVITES DE COMPARTILHAMENTO ---
    match /ftth_invitations/{inviteId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update, delete: if isVerifiedUser();
    }

    // --- TRANSFERÊNCIAS ---
    match /ftth_transfers/{transferId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update, delete: if isVerifiedUser();
    }
  }
}
